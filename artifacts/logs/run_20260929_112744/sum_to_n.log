method SumToN(n: int) returns (s: int)
    requires n >= 0
    ensures s == n * (n + 1) / 2
{
    var i := 0;
    var result := 0;
    while i <= n
        invariant 0 <= i <= n + 1
        invariant result == i * (i - 1) / 2
    {
        result := result + i;
        i := i + 1;
    }
    s := result;
}

