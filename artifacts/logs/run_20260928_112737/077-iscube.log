  ensures r && n >= 0 ==> exists r :: 0 <= r <= n && n == cube(r)
  ensures !r && n >= 0 ==> forall r :: 0 <= r <= n ==> n != cube(r)
  ensures r && n < 0 ==> exists r :: 0 <= r <= -n && n == -cube(r)
  ensures !r && n < 0 ==> forall r :: 0 <= r <= -n ==> n != -cube(r)
  // post-conditions-end
{
  if n >= 0 {
    r := cube_root(n as nat);
    r := n == cube(r);

    return;
  } else {
    r := cube_root(-n as nat);
    r := n == -cube(r);

    return;
  }
}

