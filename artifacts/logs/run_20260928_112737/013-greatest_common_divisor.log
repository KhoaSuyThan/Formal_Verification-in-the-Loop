method greatest_common_divisor(a: int, b: int) returns (gcd: int)
    requires a != 0 || b != 0
    ensures gcd != 0
{
    var cur_a := a;
    var cur_b := b;
    while cur_a != cur_b
        invariant 0 <= cur_a && 0 <= cur_b
        decreases max(cur_a, cur_b)
    {
        if cur_a > cur_b {
            cur_a := cur_a - cur_b;
        } else {
            cur_b := cur_b - cur_a;
        }
    }
    gcd := cur_a;
}

