function fib(n: nat): nat
  decreases n
{
  if n == 0 then 0
  else if n == 1 then 1
  else fib(n - 1) + fib(n - 2)
}
// pure-end
method ComputeFib(n: nat) returns (result: nat)
  // post-conditions-start
  ensures result == fib(n)
  // post-conditions-end
{
  var a := 0;
  var b := 1;
  var i := 0;
  result := 0;
  while i <= n
    decreases n - i
  {
    if i == 0 then result := a
    else if i == 1 then result := b
    else {
      var temp := a + b;
      a := b;
      b := temp;
      result := temp;
    }
    i := i + 1;
  }
}

