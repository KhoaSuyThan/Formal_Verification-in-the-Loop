function fib(n: nat): nat
  decreases n
{
  if n == 0 then 0
  else if n == 1 then 1
  else fib(n - 1) + fib(n - 2)
}
// pure-end
method ComputeFib(n: nat) returns (result: nat)
  // post-conditions-start
  ensures result == fib(n)
  // post-conditions-end
{
  // impl-start
  var a := 0;
  var b := 1;
  var i := 0;
  while i < n
    decreases n - i
  {
    var temp := a + b;
    a := b;
    b := temp;
    i := i + 1;
  }
  result := a;
  // impl-end
}

