NGUYÊN LÝ BẤT BIẾN TIỀN TỐ (PREFIX INDUCTIVE INVARIANT): Để Z3 suy diễn được hậu điều kiện toàn thể, vòng lặp BẮT BUỘC phải duy trì bất biến tiền tố cho các phần tử đã duyệt:
-> [HÀNH ĐỘNG BẮT BUỘC]: Bổ sung đầy đủ các mệnh đề invariant sau vào ngay dưới từ khóa while (theo đúng thứ tự):
   1. `invariant 0 <= i <= |l|` (bắt buộc đặt dòng đầu tiên để tránh lỗi index out of range)
   2. `invariant forall j :: 0 <= j < i ==> l[j] <= result`
Code:
method max_element(l : seq<int>) returns (result : int)
    // pre-conditions-start
    requires |l| > 0
    // pre-conditions-end
    // post-conditions-start
    ensures forall i : int :: i >= 0 && i < |l| ==> l[i] <= result
    ensures exists i : int :: i >= 0 && i < |l| && l[i] == result
    // post-conditions-end
{
    var i := 1;
    var cur_acc := l[0];
    result := l[0];

    while i < |l|
        invariant 1 <= i <= |l|
        invariant forall j :: 0 <= j < i ==> l[j] <= cur_acc
        invariant exists j :: 0 <= j < i && l[j] == cur_acc
    {if l[i] > cur_acc {
            cur_acc := l[i];
            result := l[i];
        }

        i := i + 1;
    }
}

