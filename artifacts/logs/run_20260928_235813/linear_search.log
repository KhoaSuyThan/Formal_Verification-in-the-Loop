Code:
method LinearSearch(a: array<int>, target: int) returns (r: int)
    ensures r >= 0 ==> r < a.Length && a[r] == target
    ensures r == -1 ==> forall i :: 0 <= i < a.Length ==> a[i] != target
{
    var i := 0;
    var found := false;
    var result := -1;

    while i <= a.Length
        invariant 0 <= i <= a.Length
        invariant !found ==> result == -1
        invariant found ==> result >= 0 && result < a.Length && a[result] == target
        invariant forall j :: 0 <= j < i ==> a[j] != target
        decreases a.Length - i
    {
        if i < a.Length && a[i] == target {
            found := true;
            result := i;
        }
        i := i + 1;
    }

    r := result;
}

