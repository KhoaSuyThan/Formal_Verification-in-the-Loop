NGUYÊN LÝ BẤT BIẾN TIỀN TỐ (PREFIX INDUCTIVE INVARIANT): Để Z3 suy diễn được hậu điều kiện toàn thể, vòng lặp BẮT BUỘC phải duy trì bất biến tiền tố cho các phần tử đã duyệt:
-> [HÀNH ĐỘNG BẮT BUỘC]: Bổ sung đầy đủ các mệnh đề invariant sau vào ngay dưới từ khóa while (theo đúng thứ tự):
   `invariant forall j :: 0 <= j < i ==> a[j] != target`
Code:
method LinearSearch(a: array<int>, target: int) returns (r: int)
    ensures r >= 0 ==> r < a.Length && a[r] == target
    ensures r == -1 ==> forall i :: 0 <= i < a.Length ==> a[i] != target
{
    var i := 0;
    var found := false;
    var result := -1;

    while i < a.Length
        invariant 0 <= i <= a.Length
        invariant !found ==> result == -1
        invariant found ==> result >= 0 && result < a.Length && a[result] == target
        decreases a.Length - i
    {
        if a[i] == target {
            found := true;
            result := i;
        }
        i := i + 1;
    }

    r := result;
}

