method SumToN(n: int) returns (s: int)
    requires n >= 0
    ensures s == n * (n + 1) / 2
{
    var cur_acc := 0;
    var i := 0;
    while i <= n
        invariant 0 <= i <= n + 1
        invariant forall j :: 0 <= j < i ==> cur_acc == j
        decreases n - i
    {
        cur_acc := cur_acc + i;
        i := i + 1;
    }
    s := cur_acc;
}

