Code:
method greatest_common_divisor(a: int, b: int) returns (gcd: int)
    requires a != 0 || b != 0
    ensures gcd != 0
{
    var temp: int;
    if a < 0 { a := -a; }
    if b < 0 { b := -b; }
    while a != b
        invariant 0 <= a && 0 <= b && a != b
        decreases a + b
    {
        if a > b { temp := a; a := b; b := temp; }
        b := b - a;
    }
    gcd := a;
}

