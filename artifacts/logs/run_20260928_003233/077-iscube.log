method cube_root(N: nat) returns (r: nat)
  // post-conditions-start
  ensures cube(r) <= N < cube(r + 1)
  ensures r <= N
  // post-conditions-end
{
  var low: nat := 0;
  var high: nat := N;
  var result: nat := 0;

  while low <= high
    invariant 0 <= low <= high
    invariant cube(result) <= N < cube(result + 1)
    decreases high - low
  {
    var mid: nat := (low + high) / 2;
    if cube(mid) <= N < cube(mid + 1) {
      result := mid;
      break;
    } else if cube(mid) > N {
      high := mid - 1;
    } else {
      low := mid + 1;
    }
  }
}

