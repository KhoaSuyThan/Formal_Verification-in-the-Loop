  // pre-conditions-end
  // post-conditions-start
  ensures r && n >= 0 ==> exists r :: 0 <= r <= n && n == cube(r)
  ensures !r && n >= 0 ==> forall r :: 0 <= r <= n ==> n != cube(r)
  ensures r && n < 0 ==> exists r :: 0 <= r <= -n && n == -cube(r)
  ensures !r && n < 0 ==> forall r :: 0 <= r <= -n ==> n != -cube(r)
  // post-conditions-end
{
    if n >= 0 {
        r := cube_root(n) * cube_root(n) * cube_root(n) == n;

        return;
    } else {
        r := cube_root(-n) * cube_root(-n) * cube_root(-n) == -n;

        return;
    }
}

