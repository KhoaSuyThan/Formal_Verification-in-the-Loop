{
  var i: nat := 0;
  while i * i * i <= N
    decreases N - i * i * i
  {
    i := i + 1;
  }
  r := i - 1;
}

method iscube(n: int) returns (r: bool)
  // pre-conditions-start
  // pre-conditions-end
  // post-conditions-start
  ensures r && n >= 0 ==> exists r :: 0 <= r <= n && n == cube(r)
  ensures !r && n >= 0 ==> forall r :: 0 <= r <= n ==> n != cube(r)
  ensures r && n < 0 ==> exists r :: 0 <= r <= -n && n == -cube(r)
  ensures !r && n < 0 ==> forall r :: 0 <= r <= -n ==> n != -cube(r)
  // post-conditions-end
{
    var abs_n: nat := if n < 0 then -n else n;
    var i: nat := 0;
    while i * i * i <= abs_n
      decreases abs_n - i * i * i
    {
      i := i + 1;
    }
    r := i - 1;
    if n < 0 { r := -r; }
    r := r * r * r == abs_n;
}

function cube(n: int): int { n * n * n }
// pure-end

