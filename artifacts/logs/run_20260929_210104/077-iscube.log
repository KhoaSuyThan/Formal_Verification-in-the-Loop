  ensures !r && n >= 0 ==> forall r :: 0 <= r <= n ==> n != cube(r)
  ensures r && n < 0 ==> exists r :: 0 <= r <= -n && n == -cube(r)
  ensures !r && n < 0 ==> forall r :: 0 <= r <= -n ==> n != -cube(r)
  // post-conditions-end
{
  r := iscube_helper(n, 0, n);
}

method iscube_helper(n: int, low: nat, high: nat): bool
  // pre-conditions-start
  requires low <= high
  // pre-conditions-end
  // post-conditions-start
  ensures low <= high ==> (low == high && n == cube(low) || low < high && (n == cube(low) || iscube_helper(n, low + 1, high)))
  // post-conditions-end
{
  if low == high {
    r := n == cube(low);

    return;
  } else {
    r := n == cube(low) || iscube_helper(n, low + 1, high);

    return;
  }
}

function cube(n: int): int { n * n * n }
