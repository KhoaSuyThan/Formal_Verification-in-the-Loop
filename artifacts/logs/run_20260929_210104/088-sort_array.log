method sort_array(s: seq<int>) returns (sorted: seq<int>)
  // post-conditions-start
  ensures |sorted| == |s|
  ensures |s| > 0 && (s[0] + s[|s| - 1]) % 2 == 0 ==>
    forall i, j :: 0 <= i < j < |sorted| ==> sorted[i] >= sorted[j]
  ensures |s| > 0 && (s[0] + s[|s| - 1]) % 2 != 0 ==>
    forall i, j :: 0 <= i < j < |sorted| ==> sorted[i] <= sorted[j]
  // post-conditions-end
{
  var n := |s|;
  var result := s;
  var swapped := true;

  while swapped
    decreases n
  {
    swapped := false;
    var i := 0;
    while i < n - 1
      invariant 0 <= i <= n - 1
      invariant forall j :: 0 <= j < i ==> result[j] <= result[j + 1]
      invariant forall j :: i <= j < n - 1 ==> result[j] >= result[j + 1]
    {
      if result[i] > result[i + 1]
      {
        var temp := result[i];
        result := result[i := result[i + 1]];
        result := result[i + 1 := temp];
        swapped := true;
      }
      i := i + 1;
    }
    n := n - 1;
  }

  sorted := result;
}

method reverse(s: seq<int>) returns (rev: seq<int>)
  // post-conditions-start
  ensures |rev| == |s|
  ensures forall k :: 0 <= k < |s| ==> rev[k] == s[|s| - 1 - k]
  // post-conditions-end
{
  var n := |s|;
  var result := new seq<int>(n);
  var i := 0;
  while i < n
    invariant 0 <= i <= n
    invariant forall j :: 0 <= j < i ==> result[j] == s[n - 1 - j]
  {
    result := result[i := s[n - 1 - i]];
    i := i + 1;
  }

  rev := result;
}

