method sort_array(s: seq<int>) returns (sorted: seq<int>)
  // post-conditions-start
  ensures |sorted| == |s|
  ensures |s| > 0 && (s[0] + s[|s| - 1]) % 2 == 0 ==>
    forall i, j :: 0 <= i < j < |sorted| ==> sorted[i] >= sorted[j]
  ensures |s| > 0 && (s[0] + s[|s| - 1]) % 2 != 0 ==>
    forall i, j :: 0 <= i < j < |sorted| ==> sorted[i] <= sorted[j]
  // post-conditions-end
{
  var n := |s|;
  var arr := s;
  sorted := new seq<int>(n);
  var i := 0;
  while i < n
    invariant 0 <= i <= n
    decreases n - i
  {
    var minIndex := i;
    var minValue := arr[minIndex];
    var j := i + 1;
    while j < n
      invariant 0 <= j <= n
      invariant i <= minIndex < n
      invariant minValue == arr[minIndex]
      decreases n - j
    {
      if arr[j] < minValue
      {
        minIndex := j;
        minValue := arr[j];
      }
      j := j + 1;
    }
    arr := arr[minIndex := arr[i]];
    arr := arr[i := minValue];
    i := i + 1;
  }
  sorted := arr;
  return;
}

method reverse(s: seq<int>) returns (rev: seq<int>)
  // post-conditions-start
  ensures |rev| == |s|
  ensures forall k :: 0 <= k < |s| ==> rev[k] == s[|s| - 1 - k]
  // post-conditions-end
{
  var n := |s|;
  rev := new seq<int>(n);
  var i := 0;
  while i < n
    invariant 0 <= i <= n
    decreases n - i
  {
    rev := rev[i := s[n - 1 - i]];
    i := i + 1;
  }
  return;
}

