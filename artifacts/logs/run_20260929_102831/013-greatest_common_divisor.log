method greatest_common_divisor(a: int, b: int) returns (gcd: int)
    requires a != 0 || b != 0
    ensures gcd != 0
{
    var x := if a < 0 then -a else a;
    var y := if b < 0 then -b else b;
    if x == 0 { gcd := y;
 return; }
    if y == 0 { gcd := x;
 return; }
    while y > 0
        invariant 0 < x && 0 < y
        decreases y
    {
        var temp := y;
        y := x % y;
        x := temp;
    }
    gcd := x;

    return;
}

