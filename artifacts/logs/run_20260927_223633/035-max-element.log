Code:
method max_element(l : seq<int>) returns (result : int)
    requires |l| > 0
    ensures forall i : int :: i >= 0 && i < |l| ==> l[i] <= result
    ensures exists i : int :: i >= 0 && i < |l| && l[i] == result
{
    var max : int := l[0];
    var i : int := 1;
    while i < |l|
        invariant 0 <= i <= |l|
        invariant forall j : int :: 0 <= j < i ==> l[j] <= max
        decreases |l| - i
    {
        if l[i] > max {
            max := l[i];
        }
        i := i + 1;
    }
    result := max;
}

