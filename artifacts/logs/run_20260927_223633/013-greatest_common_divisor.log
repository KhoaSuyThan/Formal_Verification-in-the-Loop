Code:
method greatest_common_divisor(a: int, b: int) returns (gcd: int)
    requires a != 0 || b != 0
    ensures gcd != 0
{
    if a == 0 {
        gcd := b;
    } else if b == 0 {
        gcd := a;
    } else {
        var temp := a;
        a := b;
        b := temp % b;
        while b != 0 decreases b {
            temp := a;
            a := b;
            b := temp % b;
        }
        gcd := a;
    }
}

