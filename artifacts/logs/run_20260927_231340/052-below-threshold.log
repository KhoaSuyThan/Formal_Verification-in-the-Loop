Error Message: [GeneralVerificationFailure] tại Dòng 6, Cột 8: Duplicate local-variable name: b
Code:
method below_threshold(l : seq<int>, t : int) returns (b : bool)
    // post-conditions-start
    ensures b == (forall i : int :: i >= 0 && i < |l| ==> l[i] < t)
    // post-conditions-end
{
    var b := true;
    var i := 0;
    while (i < |l|)
        invariant b == (forall j : int :: j >= 0 && j < i ==> l[j] < t)
        decreases |l| - i
    {
        if (l[i] >= t) {
            b := false;
            break;
        }
        i := i + 1;
    }
    return b;
}

