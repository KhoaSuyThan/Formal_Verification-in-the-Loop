method truncate_number(x : real) returns (d : real)
    requires x >= 0.0
    ensures (0.0 <= d <= 1.0)
    ensures (x - d) == (x.Floor as real)
{
    var floor_x : int := x.Floor;
    var d : real := x - floor_x;
    if d < 0.0 {
        d := 0.0;
    } else if d > 1.0 {
        d := 1.0;
    }
    return d;
}

