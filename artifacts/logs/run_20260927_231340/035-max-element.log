Code:
method max_element(l : seq<int>) returns (result : int)
    requires |l| > 0
    ensures forall i : int :: i >= 0 && i < |l| ==> l[i] <= result
    ensures exists i : int :: i >= 0 && i < |l| && l[i] == result
{
    var max : int := l[0];
    var maxIndex : int := 0;
    var i : int := 0;

    while (i < |l|)
        invariant 0 <= i <= |l|
        invariant exists j : int :: 0 <= j < i && l[j] == max
        decreases |l| - i
    {
        if (l[i] > max) {
            max := l[i];
            maxIndex := i;
        }
        i := i + 1;
    }

    result := max;
}

