lemma palindrome_concat_lemma(s: string, rev: string)
    requires |rev| == |s|
    requires forall k :: 0 <= k < |s| ==> rev[k] == s[|s| - 1 - k]
    ensures is_palindrome(s + rev)
{
    var res := s + rev;
    forall k | 0 <= k < |res|
        ensures res[k] == res[|res| - 1 - k]
    {
        if k < |s| {
            assert res[k] == s[k];
            assert res[|res| - 1 - k] == rev[|s| - 1 - k];
        } else {
            var j := k - |s|;
            assert res[k] == rev[j];
            assert res[|res| - 1 - k] == s[|s| - 1 - j];
        }
    }
}

function is_palindrome(s : string) : bool {
    forall k :: 0 <= k < |s| ==> s[k] == s[|s| - 1 - k]
}
// pure-end
function starts_with(result : string, s : string) : bool {
    |result| >= |s| && forall k :: 0 <= k < |s| ==> result[k] == s[k]
}
// pure-end
method make_palindrome(s: string) returns (result: string)
    // post-conditions-start
    ensures |result| <= 2 * |s|
    ensures is_palindrome(result)
    ensures starts_with(result, s)
    // post-conditions-end
{
    var rev := [];
    var i := 0;
    while i < |s|
        invariant 0 <= i <= |s|
        invariant |rev| == i
        invariant forall k :: 0 <= k < i ==> rev[k] == s[|s| - 1 - k]
        decreases |s| - i
    {
        rev := rev + [s[|s| - 1 - i]];
        i := i + 1;
    }
    palindrome_concat_lemma(s, rev);
    result := s + rev;
}

method reverse(str: string) returns (rev: string)
