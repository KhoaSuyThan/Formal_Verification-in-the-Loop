method cube_root(N: nat) returns (r: nat)
  // post-conditions-start
  ensures cube(r) <= N < cube(r + 1)
  ensures r <= N
  // post-conditions-end
{
  r := 0;
  while (r + 1) * (r + 1) * (r + 1) <= N
    invariant cube(r) <= N
    decreases N - cube(r)
  {
    r := r + 1;
  }
}

method iscube(n: int) returns (r: bool)
  // pre-conditions-start
  // pre-conditions-end
  // post-conditions-start
  ensures r && n >= 0 ==> exists r :: 0 <= r <= n && n == cube(r)
  ensures !r && n >= 0 ==> forall r :: 0 <= r <= n ==> n != cube(r)
  ensures r && n < 0 ==> exists r :: 0 <= r <= -n && n == -cube(r)
  ensures !r && n < 0 ==> forall r :: 0 <= r <= -n ==> n != -cube(r)
  // post-conditions-end
{
  cube_of_larger_is_larger();
  var val: nat := if n < 0 then -n else n;
  var root := cube_root(val);
  r := (cube(root) == val);
}

function cube(n: int): int { n * n * n }
// pure-end

lemma cube_of_larger_is_larger()
