method max_element(l : seq<int>) returns (result : int)
    requires |l| > 0
    ensures forall i : int :: i >= 0 && i < |l| ==> l[i] <= result
    ensures exists i : int :: i >= 0 && i < |l| && l[i] == result
{
    var max_val := l[0];
    var max_index := 0;
    var i := 1;
    while i < |l|
        invariant 0 <= i <= |l|
        invariant forall j :: 0 <= j < i ==> l[j] <= max_val
        invariant exists j :: 0 <= j < i && l[j] == max_val
    {
        if l[i] > max_val {
            max_val := l[i];
            max_index := i;
        }
        i := i + 1;
    }
    result := max_val;
}

