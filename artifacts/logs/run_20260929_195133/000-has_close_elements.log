  // post-conditions-end
{
  flag := false;
  var i := 0;
  while (i < |numbers|)
    invariant 0 <= i <= |numbers|
    decreases |numbers| - i
  {
    var j := i + 1;
    while (j < |numbers|)
      invariant 0 <= i <= |numbers|
      invariant 0 <= j <= |numbers|
      invariant j > i
      decreases |numbers| - j
    {
      if (abs(numbers[i] - numbers[j]) < threshold) 
      {
        flag := true;
        break;
      }
      j := j + 1;
    }
    i := i + 1;
  }
  return;
}

