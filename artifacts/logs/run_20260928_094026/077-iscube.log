  // pre-conditions-end
  // post-conditions-start
  ensures r && n >= 0 ==> exists r :: 0 <= r <= n && n == cube(r)
  ensures !r && n >= 0 ==> forall r :: 0 <= r <= n ==> n != cube(r)
  ensures r && n < 0 ==> exists r :: 0 <= r <= -n && n == -cube(r)
  ensures !r && n < 0 ==> forall r :: 0 <= r <= -n ==> n != -cube(r)
  // post-conditions-end
{
  if n >= 0 {
    r := iscube_helper(n, 0, n);
  } else {
    r := iscube_helper(-n, 0, -n);
  }
}

method iscube_helper(n: int, low: int, high: int): bool
  // pre-conditions-start
  // pre-conditions-end
  // post-conditions-start
  ensures low <= n <= high ==> result == (exists r :: low <= r <= high && n == cube(r))
  ensures low > n || high < n ==> result == false
  // post-conditions-end
{
  if low > high {
    r := false;

    return;
  } else {
    var mid: int := (low + high) / 2;
    if cube(mid) == n {
      r := true;

      return;
    } else if cube(mid) < n {
      r := iscube_helper(n, mid + 1, high);

      return;
    } else {
      r := iscube_helper(n, low, mid - 1);

      return;
    }
  }
}

