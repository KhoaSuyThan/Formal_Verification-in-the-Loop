Code:
method below_threshold(l : seq<int>, t : int) returns (b : bool)
    // post-conditions-start
    ensures b == (forall i : int :: i >= 0 && i < |l| ==> l[i] < t)
    // post-conditions-end
{
    b := true;
    var i := 0;
    while i < |l|
        invariant 0 <= i <= |l|
        invariant forall j :: 0 <= j < i ==> l[j] < t
        decreases |l| - i
    {
        if l[i] >= t {
            b := false;
            break;
        }
        i := i + 1;
    }
}

