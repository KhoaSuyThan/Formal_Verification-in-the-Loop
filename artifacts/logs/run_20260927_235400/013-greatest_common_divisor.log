Code:
method greatest_common_divisor(a: int, b: int) returns (gcd: int)
    requires a != 0 || b != 0
    ensures gcd != 0
{
    var temp: int;
    while a != b
        invariant 0 < a && 0 < b && 0 <= temp <= a && 0 <= temp <= b
        decreases a + b
    {
        if a > b
        {
            temp := a;
            a := b;
            b := temp;
        }
        else
        {
            b := b - a;
        }
    }
    gcd := a;
}

