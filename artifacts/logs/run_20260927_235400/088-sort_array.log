method sort_array(s: seq<int>) returns (sorted: seq<int>)
  // post-conditions-start
  ensures |sorted| == |s|
  ensures |s| > 0 && (s[0] + s[|s| - 1]) % 2 == 0 ==>
    forall i, j :: 0 <= i < j < |sorted| ==> sorted[i] >= sorted[j]
  ensures |s| > 0 && (s[0] + s[|s| - 1]) % 2 != 0 ==>
    forall i, j :: 0 <= i < j < |sorted| ==> sorted[i] <= sorted[j]
  // post-conditions-end
{
  var l := s;
  var n := |l|;
  var swapped := true;
  while swapped
    decreases n
  {
    swapped := false;
    var i := 0;
    while i < n - 1
      invariant 0 <= i <= n - 1
      invariant forall j :: 0 <= j < i ==> l[j] <= l[j + 1]
      decreases n - i
    {
      if l[i] > l[i + 1]
      {
        var temp := l[i];
        l[i] := l[i + 1];
        l[i + 1] := temp;
        swapped := true;
      }
      i := i + 1;
    }
    n := n - 1;
  }
  sorted := l;
}

method reverse(s: seq<int>) returns (rev: seq<int>)
  // post-conditions-start
  ensures |rev| == |s|
  ensures forall k :: 0 <= k < |s| ==> rev[k] == s[|s| - 1 - k]
  // post-conditions-end
{
  var n := |s|;
  var i := 0;
  var j := n - 1;
  while i < j
    invariant 0 <= i <= j < n
    decreases j - i
  {
    var temp := s[i];
    s[i] := s[j];
    s[j] := temp;
    i := i + 1;
    j := j - 1;
  }
  rev := s;
}

method SortSeq(s: seq<int>) returns (sorted: seq<int>)
  // post-conditions-start
  ensures forall i, j :: 0 <= i < j < |sorted| ==> sorted[i] <= sorted[j]
  ensures |sorted| == |s|
  ensures multiset(s) == multiset(sorted)
  // post-conditions-end
{
  var l := s;
  var n := |l|;
  var swapped := true;
  while swapped
    decreases n
  {
    swapped := false;
    var i := 0;
    while i < n - 1
      invariant 0 <= i <= n - 1
      invariant forall j :: 0 <= j < i ==> l[j] <= l[j + 1]
      decreases n - i
    {
      if l[i] > l[i + 1]
      {
        var temp := l[i];
        l[i] := l[i + 1];
        l[i + 1] := temp;
        swapped := true;
      }
      i := i + 1;
    }
    n := n - 1;
  }
  sorted := l;
}

