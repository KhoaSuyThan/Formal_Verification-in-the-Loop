method sort_array(s: seq<int>) returns (sorted: seq<int>)
  // post-conditions-start
  ensures |sorted| == |s|
  ensures |s| > 0 && (s[0] + s[|s| - 1]) % 2 == 0 ==>
    forall i, j :: 0 <= i < j < |sorted| ==> sorted[i] >= sorted[j]
  ensures |s| > 0 && (s[0] + s[|s| - 1]) % 2 != 0 ==>
    forall i, j :: 0 <= i < j < |sorted| ==> sorted[i] <= sorted[j]
  // post-conditions-end
{
  var n := |s|;
  var arr := s;
  var i := 0;
  while i < n
    invariant 0 <= i <= n
    decreases n - i
  {
    var j := i + 1;
    while j < n
      invariant 0 <= i <= j <= n
      decreases n - j
    {
      if arr[j] < arr[i] {
        var temp := arr[i];
        arr := arr[i := arr[j]];
        arr := arr[j := temp];
      }
      j := j + 1;
    }
    i := i + 1;
  }
  sorted := arr;
}

method reverse(s: seq<int>) returns (rev: seq<int>)
  // post-conditions-start
  ensures |rev| == |s|
  ensures forall k :: 0 <= k < |s| ==> rev[k] == s[|s| - 1 - k]
  // post-conditions-end
{
  var n := |s|;
  var arr := s;
  var i := 0;
  var j := n - 1;
  while i < j
    invariant 0 <= i <= j < n
    decreases j - i
  {
    var temp := arr[i];
    arr := arr[i := arr[j]];
    arr := arr[j := temp];
    i := i + 1;
    j := j - 1;
  }
  rev := arr;
}

method SortSeq(s: seq<int>) returns (sorted: seq<int>)
  // post-conditions-start
  ensures forall i, j :: 0 <= i < j < |sorted| ==> sorted[i] <= sorted[j]
  ensures |sorted| == |s|
  ensures multiset(s) == multiset(sorted)
  // post-conditions-end
{
  var n := |s|;
  var arr := s;
  var i := 0;
  while i < n
    invariant 0 <= i <= n
    decreases n - i
  {
    var j := i + 1;
    while j < n
      invariant 0 <= i <= j <= n
      decreases n - j
    {
      if arr[j] < arr[i] {
        var temp := arr[i];
        arr := arr[i := arr[j]];
        arr := arr[j := temp];
      }
      j := j + 1;
    }
    i := i + 1;
  }
  sorted := arr;
}

