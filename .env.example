# Cấu hình biến môi trường cho Formal Verification-in-the-Loop

# 1. Cấu hình Ollama Local (Mặc định không cần API key)
OLLAMA_API_BASE=http://localhost:11434

# 2. Cấu hình Cloud LLM (Nếu sử dụng mô hình trên đám mây)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 3. Đường dẫn Dafny CLI (Để trống nếu đã thêm dafny vào biến môi trường PATH)
DAFNY_PATH=
